# ── Base de données (docker compose up -d) ──────────────────────────
DATABASE_URL="postgresql://tabla:tabla@localhost:5437/tabla"

# ── WhatsApp Cloud API (Meta). Vide = mode console (messages journalisés).
WHATSAPP_JETON=""
WHATSAPP_ID_NUMERO=""
# Modèle de message approuvé par Meta pour les notifications de commande
WHATSAPP_MODELE_NOTIFICATION="tabla_nouvelle_commande"

# ── Application ─────────────────────────────────────────────────────
URL_PUBLIQUE="http://localhost:3001"
# Secret de signature des sessions de l'équipe (32+ caractères aléatoires)
SECRET_SESSION="changez-moi-par-une-longue-chaine-aleatoire-de-32-caracteres"
